{
  "name": "shopfy",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --experimental-strip-types --watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:api && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist-server/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "npm run start:api",
    "migrate:sqlite": "node --experimental-sqlite dist-server/migrate.js",
    "test": "npm run test:unit && npm run build && node --test tests/database-tls.test.mjs tests/warehouse-catalog.test.mjs tests/marketing-pricing.test.mjs tests/verification-storage.test.mjs tests/login-location.test.mjs tests/store-date-format.test.mjs && node --experimental-sqlite tests/run.mjs",
    "test:unit": "node --test tests/money.test.mjs tests/cart-orders.test.mjs tests/order-totals.test.mjs tests/billing-defaults.test.mjs tests/wallet-modal.test.mjs tests/api-read-coalescing.test.mjs tests/delivery-estimate.test.mjs tests/identity-cache.test.mjs tests/site-theme.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "framer-motion": "^14.12.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "@types/pg": "^8.23.1"
  }
}
