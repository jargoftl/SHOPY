# Backend-only settings. Never prefix these with VITE_ or commit real values.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_DATABASE_PASSWORD@SESSION_POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_BACKEND_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=shop-uploads
# Optional additional custom CA file. Supabase and system root CAs are already included:
# DATABASE_CA_CERT_PATH=/absolute/path/to/supabase-root.crt
APP_URL=https://YOUR-NETLIFY-SITE.netlify.app
# Existing administrator: set to that account's email. Do not create a new admin unintentionally.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Owner
ADMIN_PHONE=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=
# Optional HTTPS email transport, for hosts that restrict SMTP. Free plan requires sender verification.
BREVO_API_KEY=
# Existing SMTP transport still works if your host/provider permits it. HTTPS takes precedence if configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Set NODE_ENV=production on Render, not during local development.
# NODE_ENV=production

# auto: verify signup email when a mail provider is configured; allow signup otherwise.
# required: always require verification. disabled: skip it even with email configured.
SELLER_EMAIL_VERIFICATION=auto

# Seller identity review is always required for new applicants, independent of email OTP.
# Approval emails are queued until BREVO_API_KEY + EMAIL_FROM (or SMTP) are configured.
# Keep the Supabase Storage bucket private; verification photos use a separate private prefix.

# SELLER_EMAIL_VERIFICATION also controls buyer signup codes (auto/required/disabled).
# With auto, codes become mandatory when BREVO_API_KEY + EMAIL_FROM or SMTP are configured.

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store privately on the backend. Preserve this key across deployments and backups.
RECOVERY_PHRASE_KEY=
